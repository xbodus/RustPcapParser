# --- Rust / Cargo ---
# Contains all compiled artifacts, build outputs, and documentation
/target/

# Backup files generated by rustfmt when using formatting tools
**/*.rs.bk

# Crash logs dumped by rustc on an internal compiler error
rustc-ice-*.txt

# --- Windows / MSVC ---
# Debugging information files generated by MSVC Windows builds
*.pdb

# --- IDEs and Editors ---
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# --- Environment Variables ---
# Never commit your private API keys or database secrets
.env
.env.*
